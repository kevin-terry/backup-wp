#!/usr/bin/env bash
#
# backup-wp — pull a WordPress site's database and uploads down from production.
#
#   backup-wp pre                  # DB snapshot, before you deploy
#   backup-wp post                 # DB + uploads + a dated tar.zst of them
#   backup-wp post --no-archive    # ...without the tar.zst
#   backup-wp example-site db      # any site, from anywhere, by key
#
# Run it from inside a site's project directory and it works out which site you
# mean, the same way `git deploy` does. The first time it sees a site it asks
# for the SSH host, discovers the WordPress root and uploads directory on the
# server itself, and remembers all of it in ~/.config/backup-wp/<site>.conf.
# There is no site list to maintain in this file.
#
# The backup commands never write to the server: the database streams out of
# wp-cli and the uploads come down as an rsync delta transfer. `plugins
# --update` is the single exception, and it says so before it does anything.
#
# Requires: rsync, zstd, and an SSH alias per site in ~/.ssh/config.

set -euo pipefail

# A dump is every password hash, email address and API key the site holds, and
# the .part it is built in has a predictable name. Neither should be readable
# by anyone else on this machine. The uploads mirror is the one exception, and
# says so where it is created.
UMASK_WAS="$(umask)"
umask 077

# ── settings ────────────────────────────────────────────────────────────────
SITES_DIR="${SITES_DIR:-$HOME/Sites}"
BACKUP_ROOT="${BACKUP_ROOT:-$HOME/Site Backups}"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/backup-wp"
RSYNC="${RSYNC:-$(command -v rsync)}"

KEEP="${KEEP:-10}"          # dated copies to keep, per artifact type, per site
KEEP_SQL="${KEEP_SQL:-3}"   # plain .sql working copies to keep in the project

STAMP="$(date +%Y-%m-%d-%H%M%S)"
DEST_DIR="$BACKUP_ROOT/$(date +%Y)/$(date +%m)"

# ── output ──────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
    B=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; YEL=$'\033[33m'
    RED=$'\033[31m'; RST=$'\033[0m'
else
    B=''; DIM=''; GRN=''; YEL=''; RED=''; RST=''
fi

# Can we actually reach a terminal to ask a question? `[ -t 0 ]` is not enough:
# stdin may be a pipe while /dev/tty is perfectly usable, and under some
# runners /dev/tty exists but cannot be opened. Try it, quietly.
have_tty() { (exec </dev/tty) 2>/dev/null; }

step() { printf '%s==>%s %s\n' "$B" "$RST" "$*"; }
info() { printf '    %s%s%s\n' "$DIM" "$*" "$RST"; }
warn() { printf '%s !! %s%s\n' "$YEL" "$*" "$RST" >&2; }
die()  { printf '%serror:%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

# ── what this accepts from elsewhere ────────────────────────────────────────
# The uploads path discovery gets back is `wp_upload_dir()`'s basedir, which
# WordPress reads from the `upload_path` option — a row in the database. On a
# compromised site an attacker writes that string, and it lands in a config
# file this script sources. So it is checked before it is written, not after.

# Absolute, no `..`, and nothing a shell or a glob acts on: the value has to
# survive the config file, the ssh command string, and rsync's remote argument,
# which the server's login shell expands a second time.
safe_remote_path() {
    case "$1" in
        /*) ;;
        *)  return 1 ;;
    esac
    case "$1" in
        *[!A-Za-z0-9._/@+:,=%-]*) return 1 ;;
        ..|../*|*/..|*/../*)      return 1 ;;
    esac
    return 0
}

# A leading dash makes ssh and rsync read the host as an option instead, and
# -oProxyCommand=... runs a command of its own choosing.
safe_ssh_host() {
    case "$1" in
        ''|-*)                return 1 ;;
        *[!A-Za-z0-9._@%:-]*) return 1 ;;
    esac
    return 0
}

# A held plugin name is a plugin's directory name, and it is one of the few
# values here a human types straight into the config. It never reaches a shell,
# but the hold list is read by word splitting, so a `*` in it would glob against
# the working directory and hold whatever happened to be sitting there.
safe_plugin_slug() {
    case "$1" in
        ''|-*|.*)          return 1 ;;   # a leading dot or dash is not a slug
        *[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}

# Escape a value for the KEY="value" form the config uses. Inside double quotes
# a shell treats only these four characters specially, so that is the whole job.
conf_quote() {
    local v="$1"
    v="${v//\\/\\\\}"          # backslashes first, or they escape the escapes
    v="${v//\"/\\\"}"
    v="${v//\$/\\\$}"
    v="${v//\`/\\\`}"
    printf '%s' "$v"
}

# Replace HOLD_PLUGINS in an existing config, leaving every other line — the
# comments included — exactly where the user found them. A line at a time
# rather than sed, because the whole point is to touch nothing else in a file
# that is about to be sourced.
conf_set_hold() {
    local value="$1" line found=0 tmp="$CONF.new"
    : > "$tmp"
    # `|| [ -n "$line" ]` so a final line with no newline is not dropped.
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            HOLD_PLUGINS=*)
                printf 'HOLD_PLUGINS="%s"\n' "$(conf_quote "$value")" >> "$tmp"
                found=1 ;;
            *)  printf '%s\n' "$line" >> "$tmp" ;;
        esac
    done < "$CONF"
    # Configs written before the setting existed have no line to replace.
    if [ "$found" -eq 0 ]; then
        printf 'HOLD_PLUGINS="%s"\n' "$(conf_quote "$value")" >> "$tmp"
    fi
    mv "$tmp" "$CONF" || { rm -f "$tmp"; die "could not write $CONF"; }
}

usage() {
    cat <<'EOF'
usage: backup-wp [<site>] [<what>] [options]

what
  pre        database only, tagged "pre-update"   (run before `git deploy`)
  post       database tagged "post-update" + uploads (run after the deploy)
             implies --archive; --no-archive turns it back off
  db         database only, untagged
  uploads    uploads mirror only
  all        database + uploads                 (the default)
  plugins    list pending plugin updates; --update applies them

options
  -a, --archive     also build a dated .tar.zst of the uploads
      --no-archive  skip that archive where it is the default
  -n, --dry-run     show what would happen; transfers nothing
  -f, --force       skip the first-run confirmation before an rsync --delete
      --no-prune    keep every old snapshot instead of trimming to $KEEP
      --no-rescue   delete outright instead of moving replaced files aside
      --update      with `plugins`, apply every server-managed update
      --update=a,b  ...or only the plugins named
      --hold=a,b    never update these on this site; remembered in its config
      --unhold=a,b  let --update have them again
      --setup       (re)run discovery for this site and rewrite its config
      --host <a>    set up against ssh alias <a> without asking (implies --setup)
      --list        list configured sites and exit
  -h, --help        this

Site is taken from the current project directory when omitted. Backups land in
"~/Site Backups/<year>/<month>/<site>/"; the newest .sql is also dropped in the
project's sql/ dir as latest.sql so it is one command to import.

Plugins held with --hold are never updated. They are listed as "held" when an
update is pending, and --update passes over them. The list lives in HOLD_PLUGINS
in the site's config, editable by hand and kept across --setup.

Retention only ever considers files sitting exactly at
<root>/<year>/<month>/<site>/<site>-db-*.sql.gz (or -uploads-*.tar.zst).
Anything you file anywhere else under the backup root is never touched.

The uploads mirror is exact, so it removes local files production does not
have. They are moved to <...>/<site>/rescued-<stamp>/ first, not deleted.
EOF
}

# ── argument parsing ────────────────────────────────────────────────────────
# ARCHIVE starts empty rather than 0 so `post` can default it to 1 below
# without overriding an explicit --no-archive, whichever order they were given.
SITE=""; WHAT=""; ARCHIVE=""; DRY=0; FORCE=0; PRUNE=1; SETUP=0; HOST_ARG=""
RESCUE_ON=1; APPLY=0; ONLY=""; HOLD_ADD=""; HOLD_DEL=""

while [ $# -gt 0 ]; do
    case "$1" in
        pre|post|db|uploads|all|plugins)
            [ -z "$WHAT" ] || die "more than one action given: $WHAT and $1"
            WHAT="$1" ;;
        -a|--archive)  ARCHIVE=1 ;;
        --no-archive)  ARCHIVE=0 ;;
        -n|--dry-run)  DRY=1 ;;
        -f|--force)    FORCE=1 ;;
        --no-prune)    PRUNE=0 ;;
        --no-rescue)   RESCUE_ON=0 ;;
        --update)      APPLY=1 ;;
        --update=*)    APPLY=1; ONLY="${1#--update=}"
                       [ -n "$ONLY" ] || die "--update= needs a plugin name" ;;
        # Accumulated rather than assigned, so repeating the flag works as well
        # as the comma list --update= already taught.
        --hold=*)      HOLD_ADD="$HOLD_ADD ${1#--hold=}"
                       [ -n "${1#--hold=}" ] || die "--hold= needs a plugin name" ;;
        --unhold=*)    HOLD_DEL="$HOLD_DEL ${1#--unhold=}"
                       [ -n "${1#--unhold=}" ] || die "--unhold= needs a plugin name" ;;
        --hold|--unhold)
                       die "$1 takes the name with it: $1=<plugin>" ;;
        --setup)       SETUP=1 ;;
        --host)        shift; [ $# -gt 0 ] || die "--host needs an ssh alias"
                       HOST_ARG="$1"; SETUP=1 ;;
        --list)
            ls "$CONF_DIR"/*.conf >/dev/null 2>&1 || die "no sites configured yet"
            for f in "$CONF_DIR"/*.conf; do
                # Sourcing a runtime path is the point; read in a subshell so
                # one site's values cannot leak into the next iteration.
                # shellcheck disable=SC1090
                ( . "$f"
                  printf '%s%s%s\n' "$B" "$(basename "$f" .conf)" "$RST"
                  printf '    %-9s %s\n' host "$SSH_HOST"
                  printf '    %-9s %s\n' remote "$REMOTE_WP"
                  printf '    %-9s %s\n' uploads "$REMOTE_UPLOADS"
                  printf '    %-9s %s\n' local "$SITE_DIR"
                  if [ -n "${HOLD_PLUGINS:-}" ]; then
                      printf '    %-9s %s\n' held "$HOLD_PLUGINS"
                  fi )
            done
            exit 0 ;;
        -h|--help)     usage; exit 0 ;;
        -*)            die "unknown option: $1" ;;
        *)
            [ -z "$SITE" ] || die "more than one site given: $SITE and $1"
            SITE="$1" ;;
    esac
    shift
done

# Editing the hold list is part of `plugins`, and the only thing anyone means
# by it on its own — defaulting to `all` there would run a whole backup as a
# side effect of changing a setting.
if [ -n "$HOLD_ADD$HOLD_DEL" ]; then
    case "$WHAT" in
        ''|plugins) WHAT="plugins" ;;
        *)          die "--hold and --unhold belong to \`plugins\`, not \`$WHAT\`" ;;
    esac
fi

WHAT="${WHAT:-all}"
DO_PLUGINS=0
case "$WHAT" in
    pre)     DO_DB=1; DO_UP=0; LABEL="pre-update"  ;;
    # `post` is the after-the-deploy record of what production held, so it
    # keeps the archive as well as the mirror unless told otherwise.
    post)    DO_DB=1; DO_UP=1; LABEL="post-update"; ARCHIVE="${ARCHIVE:-1}" ;;
    db)      DO_DB=1; DO_UP=0; LABEL=""     ;;
    uploads) DO_DB=0; DO_UP=1; LABEL=""     ;;
    all)     DO_DB=1; DO_UP=1; LABEL=""     ;;
    plugins) DO_DB=0; DO_UP=0; LABEL=""; DO_PLUGINS=1 ;;
esac
ARCHIVE="${ARCHIVE:-0}"

# ── which site? ─────────────────────────────────────────────────────────────
# Recognise a project by structure, never by directory name. Docroots get
# called public_html, public, web, htdocs, httpdocs, wordpress and plenty else;
# a hardcoded list would turn away a perfectly valid project.
looks_like_wp_project() {
    if [ -e "$1/wp-cli.yml" ] || [ -e "$1/wp-config.php" ]; then return 0; fi
    local d
    for d in "$1"/*/; do          # one level down, whatever the docroot is called
        if [ -e "${d}wp-config.php" ] || [ -e "${d}wp-load.php" ]; then return 0; fi
    done
    # Deeper or unusually nested layouts. One bounded search, pruning the trees
    # that are always huge and never hold a wp-config.php. No pipe into head:
    # under `set -o pipefail` a SIGPIPE'd find would read as "not found".
    local hit
    hit="$(find "$1" -maxdepth 3 \
             \( -name node_modules -o -name vendor -o -name .git \) -prune -o \
             \( -name wp-config.php -o -name wp-load.php \) -print 2>/dev/null)"
    [ -n "$hit" ]
}

# No argument: use the git top level of wherever we are, exactly like
# `git deploy`. An argument is a key under ~/Sites, or a site we already know.
if [ -z "$SITE" ]; then
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    SITE="$(basename "$root")"
    SITE_DIR="$root"
    looks_like_wp_project "$SITE_DIR" \
        || die "$(printf '%s does not look like a WordPress project.\n       cd into one, or name a site: backup-wp <site> %s' "$SITE_DIR" "$WHAT")"
elif [ -d "$SITES_DIR/$SITE" ]; then
    SITE_DIR="$SITES_DIR/$SITE"
elif [ -r "$CONF_DIR/$SITE.conf" ]; then
    SITE_DIR=""   # filled in from the config below
else
    die "no site \"$SITE\" in $SITES_DIR and no config for it. Run: backup-wp $SITE --setup"
fi

# The site key becomes a filename in the config directory and the leading half
# of every retention pattern: a `/` writes the config elsewhere entirely, and a
# `*` widens `find -name "$SITE-db-*.sql.gz"` onto other sites' snapshots.
# Spaces and accents are fine — every use of it is quoted.
case "$SITE" in
    ''|.|..)                           die "\"$SITE\" is not a usable site name" ;;
    -*)                                die "a site name cannot start with a dash: $SITE" ;;
    */*|*'*'*|*'?'*|*'['*|*']'*|*\\*)  die "a site name cannot contain / * ? [ ] or \\: $SITE" ;;
    *[[:cntrl:]]*)                     die "a site name cannot contain control characters" ;;
esac

CONF="$CONF_DIR/$SITE.conf"

# ── first run: ask once, discover the rest, never ask again ─────────────────
pick_ssh_host() {
    # Host aliases from ~/.ssh/config, minus wildcards.
    local -a hosts=()
    if [ -r "$HOME/.ssh/config" ]; then
        set -f   # a bare `Host *` would otherwise glob against the cwd
        while read -r _ rest; do
            for h in $rest; do
                case "$h" in *[\*\?\!]*) continue ;; esac      # patterns, not hosts
                case " ${hosts[*]-} " in *" $h "*) continue ;; esac
                hosts+=("$h")
            done
        done < <(grep -iE '^[[:space:]]*Host[[:space:]]' "$HOME/.ssh/config" || true)
        set +f
    fi

    if [ ${#hosts[@]} -gt 0 ]; then
        printf '\n    %sSSH hosts in ~/.ssh/config:%s\n' "$DIM" "$RST" >&2
        local i=1
        for h in "${hosts[@]}"; do printf '      %2d) %s\n' "$i" "$h" >&2; i=$((i+1)); done
        printf '\n' >&2
    fi

    local answer
    read -r -p "    Which host serves ${B}$SITE${RST}? (number, or user@host) " answer </dev/tty 2>/dev/null \
        || die "no terminal to ask on — pass --host <ssh-alias> instead"
    [ -n "$answer" ] || die "no host given"
    case "$answer" in
        ''|*[!0-9]*) printf '%s' "$answer" ;;
        *)
            [ "$answer" -ge 1 ] && [ "$answer" -le ${#hosts[@]} ] || die "no host #$answer"
            printf '%s' "${hosts[$((answer-1))]}" ;;
    esac
}

# Everything below runs on the server, read-only, over one connection.
probe_remote() {
    ssh "${SSH_OPTS[@]}" "$SSH_HOST" bash -s <<'REMOTE'
set -u

wp=""
for c in "$(command -v wp 2>/dev/null || true)" "$HOME/bin/wp" \
         /usr/local/bin/wp /usr/bin/wp; do
    [ -n "$c" ] && [ -x "$c" ] && { wp="$c"; break; }
done
[ -n "$wp" ] || { echo "NOWP"; exit 0; }

# Candidate roots: anywhere a wp-cli.yml, wp-config.php or wp-load.php lives.
# Each is then proved by actually running wp there, so a false candidate costs
# nothing and no single marker has to be present.
#
# wp-load.php matters on its own because wp-cli only ever searches upward from
# the current directory. WordPress permits wp-config.php to sit one level ABOVE
# its root, and that layout is widely recommended for hardening — searching for
# wp-config.php alone would land on a directory wp can do nothing with, while
# the real root just below it went unexamined. wp-load.php is always in the
# root, so it points at the one directory wp-cli can actually be run from.
#
# Resolve $HOME first and search with -L: on some shared hosts $HOME is itself
# a symlink pointing into a shared container path, and find will not descend
# through a symlinked starting point, so the plain form silently finds nothing.
root="$(cd "$HOME" 2>/dev/null && pwd -P)" || root="$HOME"
find -L "$root" -maxdepth 5 \
     \( -name wp-cli.yml -o -name wp-config.php -o -name wp-load.php \) \
     -not -path '*/vendor/*' -not -path '*/node_modules/*' \
     2>/dev/null | while read -r f; do dirname "$f"; done | sort -u |
while read -r dir; do
    cd "$dir" 2>/dev/null || continue
    "$wp" core version --skip-plugins --skip-themes >/dev/null 2>&1 || continue
    up="$("$wp" eval 'echo wp_upload_dir()["basedir"];' 2>/dev/null)" || continue
    [ -n "$up" ] && [ -d "$up" ] || continue
    printf 'OK\t%s\t%s\t%s\n' "$wp" "$dir" "$up"
done
REMOTE
}

setup_site() {
    step "Setting up ${B}$SITE${RST}"
    if [ -n "$SITE_DIR" ]; then info "project  $SITE_DIR"; fi

    if [ -n "$HOST_ARG" ]; then
        SSH_HOST="$HOST_ARG"
    else
        have_tty || die "no config for $SITE. Run it in a terminal, or pass --host <ssh-alias>."
        SSH_HOST="$(pick_ssh_host)"
    fi
    safe_ssh_host "$SSH_HOST" \
        || die "\"$SSH_HOST\" is not a usable ssh target — give an ~/.ssh/config alias or user@host"

    step "Checking $SSH_HOST"
    ssh "${SSH_OPTS[@]}" "$SSH_HOST" true || die "cannot reach $SSH_HOST over ssh"

    step "Looking for WordPress on $SSH_HOST"
    local out; out="$(probe_remote)"
    [ "$out" != "NOWP" ] || die "wp-cli is not on the PATH on $SSH_HOST"

    # A layout that keeps its docroot in a subdirectory validates twice — once
    # at the project root with wp-cli.yml, once at the docroot below it. Both
    # report the same uploads dir, so keep only the first hit per uploads dir;
    # the remote sorts its output, which puts the parent ahead of the child.
    #
    # Candidates that fail safe_remote_path drop out here rather than at the
    # end, so one oddly named install does not block setting up a sound one.
    local -a found=() seen=() rejected=()
    local line dir up rej
    while IFS= read -r line; do
        case "$line" in OK$'\t'*) ;; *) continue ;; esac
        dir="$(cut -f3 <<<"$line")"
        up="$(cut -f4 <<<"$line")"
        if ! safe_remote_path "$dir" || ! safe_remote_path "$up"; then
            rejected+=("$dir → $up")
            continue
        fi
        case " ${seen[*]-} " in *" $up "*) continue ;; esac
        seen+=("$up")
        found+=("$line")
    done <<<"$out"
    if [ ${#found[@]} -eq 0 ]; then
        if [ ${#rejected[@]} -gt 0 ]; then
            for rej in "${rejected[@]}"; do warn "refused: $rej"; done
            die "$(printf 'every install found has a path this script will not put in a shell command.\n       Write %s by hand if those really are the paths.' "$CONF")"
        fi
        die "found no working WordPress install under \$HOME on $SSH_HOST"
    fi
    if [ ${#rejected[@]} -gt 0 ]; then
        warn "ignored ${#rejected[@]} install(s) whose paths hold characters a shell would act on"
    fi

    local choice
    if [ ${#found[@]} -eq 1 ]; then
        choice="${found[0]}"
    else
        have_tty || die "$SSH_HOST hosts ${#found[@]} installs — re-run in a terminal to pick one"
        printf '\n    %sfound %d installs:%s\n' "$DIM" "${#found[@]}" "$RST" >&2
        local i=1
        for f in "${found[@]}"; do
            printf '      %2d) %s\n' "$i" "$(cut -f3 <<<"$f")" >&2; i=$((i+1))
        done
        printf '\n' >&2
        local n; read -r -p "    Which one is $SITE? " n </dev/tty 2>/dev/null \
            || die "no terminal to ask on"
        [ -n "$n" ] && [ "$n" -ge 1 ] 2>/dev/null && [ "$n" -le ${#found[@]} ] || die "no install #${n:-}"
        choice="${found[$((n-1))]}"
    fi

    REMOTE_WP_BIN="$(cut -f2 <<<"$choice")"
    REMOTE_WP="$(cut -f3 <<<"$choice")"
    REMOTE_UPLOADS="$(cut -f4 <<<"$choice")"

    [ -n "$SITE_DIR" ] || SITE_DIR="$SITES_DIR/$SITE"
    [ -d "$SITE_DIR" ] || die "no local project at $SITE_DIR"

    # A deploy normally rsyncs the tree as-is, so uploads sit at the same path
    # relative to the WordPress root on both ends. Deriving the local path from
    # that relationship works for any docroot name — httpdocs, web, htdocs —
    # without this script knowing a single one of them.
    #
    # Only when the remote uploads live outside the remote project root (a
    # shared or symlinked media dir) is there no relationship to derive from.
    # Then look for an uploads dir that already exists locally, and say plainly
    # that the answer was a guess.
    UPLOADS_GUESSED=0
    case "$REMOTE_UPLOADS" in
        # $REMOTE_WP is quoted inside the expansion so it strips as a literal
        # prefix; unquoted it would be read as a glob pattern and a remote path
        # containing [ ] ? * would silently fail to strip.
        "$REMOTE_WP"/*) LOCAL_UPLOADS="$SITE_DIR/${REMOTE_UPLOADS#"$REMOTE_WP"/}" ;;
        *)
            UPLOADS_GUESSED=1
            LOCAL_UPLOADS=""
            for depth in 1 2 3; do          # shallowest match wins
                if [ -z "$LOCAL_UPLOADS" ]; then
                    LOCAL_UPLOADS="$(find "$SITE_DIR" -mindepth "$depth" -maxdepth "$depth" \
                        -type d -name uploads -not -path '*/node_modules/*' \
                        -not -path '*/vendor/*' 2>/dev/null | head -1)"
                fi
            done
            LOCAL_UPLOADS="${LOCAL_UPLOADS:-$SITE_DIR/uploads}" ;;
    esac

    # HOLD_PLUGINS is the one setting here nothing discovers — a human writes
    # it — so a --setup that rewrites everything else has to carry it over.
    # Read it back the same way the script normally would, in a subshell so the
    # old file's other values cannot overwrite what discovery just found.
    if [ -r "$CONF" ]; then
        # shellcheck disable=SC1090
        HOLD_PLUGINS="$( . "$CONF" 2>/dev/null; printf '%s' "${HOLD_PLUGINS:-}" )" \
            || HOLD_PLUGINS=""
    fi

    # Everything is escaped on the way in. The remote values passed
    # safe_remote_path already; the local ones never do — a directory here may
    # legitimately be called anything, and this file gets sourced.
    mkdir -p "$CONF_DIR"
    cat > "$CONF" <<EOF
# backup-wp — $SITE
# discovered $(date '+%Y-%m-%d %H:%M'). Delete this file or run --setup to redo.
SITE_DIR="$(conf_quote "$SITE_DIR")"
SSH_HOST="$(conf_quote "$SSH_HOST")"
REMOTE_WP="$(conf_quote "$REMOTE_WP")"
REMOTE_WP_BIN="$(conf_quote "$REMOTE_WP_BIN")"
REMOTE_UPLOADS="$(conf_quote "$REMOTE_UPLOADS")"
LOCAL_UPLOADS="$(conf_quote "$LOCAL_UPLOADS")"

# Plugins to hold back: names \`backup-wp $SITE plugins\` shows as "server",
# separated by spaces or commas. Held plugins are listed but never updated,
# and this line survives --setup. Example: HOLD_PLUGINS="woocommerce acf-pro"
HOLD_PLUGINS="$(conf_quote "${HOLD_PLUGINS:-}")"
EOF

    step "Saved ${DIM}$CONF${RST}"
    info "remote   $REMOTE_WP"
    info "uploads  $REMOTE_UPLOADS"
    info "mirror   $LOCAL_UPLOADS"
    if [ "$UPLOADS_GUESSED" -eq 1 ]; then
        warn "remote uploads sit outside $REMOTE_WP, so the mirror path is a guess"
        warn "check LOCAL_UPLOADS in $CONF before the first sync"
    fi
    printf '\n'
}

# One authenticated connection for the whole run — the passphrase, if the
# keychain does not supply it, gets asked for once rather than three times.
SSH_OPTS=(-o ControlMaster=auto -o ControlPath="$HOME/.ssh/cm-%C" -o ControlPersist=120)

if [ "$SETUP" -eq 1 ] || [ ! -r "$CONF" ]; then
    setup_site
else
    # shellcheck disable=SC1090
    . "$CONF"
fi

: "${SSH_HOST:?$CONF is missing SSH_HOST}"
: "${REMOTE_WP:?$CONF is missing REMOTE_WP}"
: "${REMOTE_UPLOADS:?$CONF is missing REMOTE_UPLOADS}"
: "${SITE_DIR:?$CONF is missing SITE_DIR}"
: "${REMOTE_WP_BIN:=wp}"

# Sourcing has already happened by the time we get here, so this cannot stop
# code hiding in the file — only stop a bad value reaching ssh or rsync, which
# is the half that costs data. Configs written before these checks existed have
# never been vetted at all. REMOTE_WP_BIN is exempt: `printf %q` covers both of
# its uses, and it defaults to the bare word `wp`.
safe_ssh_host "$SSH_HOST"          || die "$CONF has an SSH_HOST that ssh would read as an option or a pattern: $SSH_HOST"
safe_remote_path "$REMOTE_WP"      || die "$CONF has a REMOTE_WP this script will not put in a shell command: $REMOTE_WP"
safe_remote_path "$REMOTE_UPLOADS" || die "$CONF has a REMOTE_UPLOADS this script will not put in a shell command: $REMOTE_UPLOADS"
: "${HOLD_PLUGINS:=}"   # unset in every config written before it existed

LOCAL_SQL="$SITE_DIR/sql"

# ── paths for this run ──────────────────────────────────────────────────────
SITE_BACKUPS="$DEST_DIR/$SITE"
# The label sits between the kind and the date so a listing groups by what the
# snapshot is; the stamp always ends the name, which is where retention reads it
# back from.
NAME="$SITE-db${LABEL:+-$LABEL}-$STAMP"
DB_GZ="$SITE_BACKUPS/$NAME.sql.gz"
DB_SQL="$LOCAL_SQL/$NAME.sql"
UP_TAR="$SITE_BACKUPS/$SITE-uploads-$STAMP.tar.zst"
MIRRORED="$CONF_DIR/$SITE.mirrored"

trap 'rm -f "$DB_GZ.part" "$DB_SQL.part" "$UP_TAR.part"' EXIT

printf '%s%s%s  %s%s → %s%s\n\n' \
    "$B" "$SITE" "$RST" "$DIM" "$SSH_HOST" "$BACKUP_ROOT" "$RST"
if [ "$DRY" -eq 1 ]; then warn "dry run — nothing will be written or transferred"; fi

# ── 1. database ─────────────────────────────────────────────────────────────
# The DB goes first: a wrong path or a missing wp-cli fails in seconds instead
# of after the uploads transfer. gzip runs on the server, so what crosses the
# wire is already compressed ~10:1.
if [ "$DO_DB" -eq 1 ]; then
    step "Database${LABEL:+ ($LABEL)}"

    if [ "$DRY" -eq 1 ]; then
        info "would write $DB_GZ"
        info "would write $DB_SQL"
    else
        mkdir -p "$SITE_BACKUPS" "$LOCAL_SQL"

        # The printf %q calls deliberately expand here, on the client, to build
        # a safely quoted command string for the remote shell.
        # shellcheck disable=SC2029
        ssh "${SSH_OPTS[@]}" "$SSH_HOST" \
            "cd $(printf %q "$REMOTE_WP") && $(printf %q "$REMOTE_WP_BIN") db export - \
                --single-transaction --quick --default-character-set=utf8mb4 \
                --skip-plugins --skip-themes | gzip -6" > "$DB_GZ.part"

        gzip -t "$DB_GZ.part" || die "the dump did not survive the trip (bad gzip)"
        gunzip -c "$DB_GZ.part" > "$DB_SQL.part"

        # Judge the SQL, not the gzip: a well-compressed dump can be tiny.
        size=$(wc -c < "$DB_SQL.part" | tr -d '[:space:]')
        [ "$size" -gt 4096 ] || die "only $size bytes of SQL came back — treating that as a failure"
        tail -c 512 "$DB_SQL.part" | grep -q "Dump completed" \
            || warn "no \"Dump completed\" marker — the dump may be truncated"

        mv "$DB_GZ.part" "$DB_GZ"
        mv "$DB_SQL.part" "$DB_SQL"
        ln -sf "$(basename "$DB_SQL")" "$LOCAL_SQL/latest.sql"

        info "$(du -h "$DB_GZ" | cut -f1)  $DB_GZ"
        info "import with: ${B}wp db import sql/latest.sql${RST}"
    fi
fi

# ── 2. uploads ──────────────────────────────────────────────────────────────
if [ "$DO_UP" -eq 1 ]; then
    step "Uploads"

    # The one command here that deletes, so its destination is checked rather
    # than trusted: an empty or hand-edited LOCAL_UPLOADS would aim
    # `rsync --delete` at a whole home directory.
    case "${LOCAL_UPLOADS:-}" in
        '')                  die "$CONF sets no LOCAL_UPLOADS, so the mirror has no destination" ;;
        ..|../*|*/..|*/../*) die "LOCAL_UPLOADS must not climb with \"..\" — fix it in $CONF" ;;
        /|"$HOME"|"$HOME"/)  die "refusing to mirror over $LOCAL_UPLOADS — fix LOCAL_UPLOADS in $CONF" ;;
        /*)                  ;;
        *)                   die "LOCAL_UPLOADS must be an absolute path — fix it in $CONF" ;;
    esac

    # Public website media a local web server may need to read: the one thing
    # created with the caller's umask, not the private one set at the top.
    ( umask "$UMASK_WAS"; mkdir -p "$LOCAL_UPLOADS" )

    # The comma in --info=stats1,del is rsync's own syntax, not an array
    # separator: it stays inside one element. shellcheck cannot tell.
    #
    # --safe-links drops symlinks arriving from the server that point out of
    # the tree: uploads is the most routinely compromised part of a WP site.
    # shellcheck disable=SC2054
    RSYNC_ARGS=(-a --delete --safe-links --partial --human-readable --info=stats1,del
        --exclude 'cache/'
        --exclude '.DS_Store'
        -e "ssh ${SSH_OPTS[*]}")

    # Anything the mirror is about to delete or overwrite is moved aside first,
    # into a dated folder beside this run's archives. rsync does this itself, so
    # it costs no extra pass and no file list to parse — and it turns an exact
    # mirror from a one-way door into something you can undo by hand.
    RESCUE="$SITE_BACKUPS/rescued-$STAMP"
    if [ "$RESCUE_ON" -eq 1 ]; then
        mkdir -p "$SITE_BACKUPS"
        RSYNC_ARGS+=(--backup --backup-dir="$RESCUE")
    fi

    # An exact mirror deletes local-only files, which is what a backup wants
    # but not what you want to discover the first time you point this at a
    # project that has dev media in it. Confirm once, then never again.
    if [ ! -e "$MIRRORED" ] && [ "$FORCE" -eq 0 ] && [ "$DRY" -eq 0 ] \
       && [ -n "$(ls -A "$LOCAL_UPLOADS" 2>/dev/null)" ]; then
        doomed=$("$RSYNC" -n "${RSYNC_ARGS[@]}" \
                    "$SSH_HOST:$REMOTE_UPLOADS/" "$LOCAL_UPLOADS/" \
                 | grep -c '^deleting ' || true)
        if [ "$doomed" -gt 0 ]; then
            warn "first mirror of $LOCAL_UPLOADS would remove $doomed local file(s) not on production"
            if [ "$RESCUE_ON" -eq 1 ]; then
                info "they will be copied to $RESCUE first"
            else
                warn "--no-rescue is set, so they will be gone for good"
            fi
            have_tty || die "no terminal to confirm on. List them with \`backup-wp $SITE uploads -n\`, then pass --force to go ahead."
            read -r -p "    continue? [y/N] " ok </dev/tty
            case "$ok" in
                [yY]*) ;;
                *) die "stopped, nothing removed. List them with \`backup-wp $SITE uploads -n\`." ;;
            esac
        fi
    fi

    if [ "$DRY" -eq 1 ]; then RSYNC_ARGS+=(-n); fi
    "$RSYNC" "${RSYNC_ARGS[@]}" "$SSH_HOST:$REMOTE_UPLOADS/" "$LOCAL_UPLOADS/"
    if [ "$DRY" -eq 0 ]; then : > "$MIRRORED"; fi

    if [ "$DRY" -eq 0 ] && [ -d "$RESCUE" ]; then
        info "$(find "$RESCUE" -type f | wc -l | tr -d ' ') file(s) moved aside → $RESCUE"
    fi
    # Leaves no empty dated folder behind on a run that rescued nothing.
    rmdir "$SITE_BACKUPS" 2>/dev/null || true

    if [ "$ARCHIVE" -eq 1 ]; then
        step "Archive"
        if [ "$DRY" -eq 1 ]; then
            info "would write $UP_TAR"
        else
            mkdir -p "$SITE_BACKUPS"
            tar -C "$(dirname "$LOCAL_UPLOADS")" -cf - "$(basename "$LOCAL_UPLOADS")" \
                | zstd -3 -T0 -q -f -o "$UP_TAR.part"
            zstd -t "$UP_TAR.part" 2>/dev/null || die "archive failed verification"
            mv "$UP_TAR.part" "$UP_TAR"
            info "$(du -h "$UP_TAR" | cut -f1)  $UP_TAR"
        fi
    fi
fi

# ── 3. plugins ──────────────────────────────────────────────────────────────
# The one command in this script that writes to the server.
#
# wp-cli is not subject to DISALLOW_FILE_MODS. That constant is enforced in
# map_meta_cap(), which rewrites update_plugins to do_not_allow — a *capability*
# check, so it only binds code that asks "may the current user do this?". That
# is the admin UI. wp-cli runs with no user and never asks, so a site locked
# down for its editors is still updatable over ssh.
remote_wp() {
    local a args=""
    for a in "$@"; do args="$args $(printf %q "$a")"; done
    # printf %q expands here, on purpose, to build a safely quoted remote command
    # shellcheck disable=SC2029
    ssh "${SSH_OPTS[@]}" "$SSH_HOST" \
        "cd $(printf %q "$REMOTE_WP") && $(printf %q "$REMOTE_WP_BIN")$args"
}

# Plugin slugs Composer owns, taken from the project's composer.json: the half
# of "vendor/name" after the slash is the directory Composer installs into.
# No composer.json means nothing is Composer-managed, which is the right answer
# for a site that is not built that way.
composer_owned() {
    [ -r "$SITE_DIR/composer.json" ] || return 0
    grep -oE '"[A-Za-z0-9_.:-]+/[A-Za-z0-9_.-]+"[[:space:]]*:' "$SITE_DIR/composer.json" \
        | sed 's/^"//; s/"[[:space:]]*:$//' \
        | awk -F/ '{print $2}' | sort -u
}

# Plugins the site's config holds back from updating. Parsed by `plugins`
# rather than alongside the other config checks because that is the only
# command it means anything to: a typo in it is worth stopping `plugins` over
# and not worth stopping a backup over.
HELD=""
is_held() {
    case " $HELD " in *" $1 "*) return 0 ;; esac
    return 1
}

if [ "$DO_PLUGINS" -eq 1 ]; then
    step "Plugins"

    # Commas are accepted as well as spaces — --update=a,b takes them, and
    # nobody should have to remember which spelling goes where. `set -f` for
    # the split: an entry is a glob until safe_plugin_slug has looked at it,
    # and a bare `*` would otherwise expand to the working directory and hold
    # whatever is sitting in it.
    set -f
    for slug in $(printf '%s' "$HOLD_PLUGINS" | tr ',' ' '); do
        safe_plugin_slug "$slug" \
            || die "$CONF holds \"$slug\" in HOLD_PLUGINS, which is not a plugin name — those are letters, digits, dots, dashes and underscores"
        HELD="$HELD $slug"
    done
    set +f

    # No --skip-plugins here: premium plugins register their own update checks,
    # so skipping them hides exactly the updates this command exists to find.
    #
    # Nor is loading them enough. Licensed plugins routinely register their
    # update checker inside `if ( is_admin() )`, and wp-cli is not admin
    # context — so a perfectly licensed plugin reports "none" forever. Defining
    # WP_ADMIN makes those checkers register and answer. It is not free: a
    # plugin may assume wp-admin/includes is loaded whenever is_admin() is true
    # and fatal without it, so fall back to a plain listing if it misbehaves.
    admin_ctx=1
    listing="$(remote_wp --exec="define('WP_ADMIN', true);" \
                 plugin list --fields=name,status,version,update,update_version \
                             --format=csv 2>/dev/null)" || listing=""
    case "$listing" in
        name,*) ;;
        *)  admin_ctx=0
            listing="$(remote_wp plugin list \
                         --fields=name,status,version,update,update_version \
                         --format=csv)" \
                || die "could not list plugins on $SSH_HOST" ;;
    esac

    # `wp plugin list` reports "none" for two very different situations: the
    # plugin is current, or nothing ever asked about it. Premium plugins hook
    # their update checks on admin-only actions and wp-cli never loads admin
    # context, so they are simply absent from the update data — and "none"
    # then reads as reassurance it has not earned. Ask which plugins WordPress
    # has actually heard from, so the silent ones can be named instead.
    # shellcheck disable=SC2016  # PHP, not shell — it must not expand here
    known="$(remote_wp eval '
$t = get_site_transient("update_plugins");
if (!$t) { exit; }
$r = isset($t->response)  ? (array) $t->response  : array();
$n = isset($t->no_update) ? (array) $t->no_update : array();
foreach (array_merge(array_keys($r), array_keys($n)) as $f) { echo dirname($f), "\n"; }
' 2>/dev/null)" || known=""

    # --hold and --unhold are applied here, between the listing and the table,
    # for two reasons: a name can be checked against what is actually installed
    # — a misspelled hold would otherwise sit in the config holding nothing,
    # which is the failure this whole setting exists to prevent — and the table
    # printed below then shows the list as it now stands.
    if [ -n "$HOLD_ADD$HOLD_DEL" ]; then
        # Field 1 of the CSV, minus its header. Names cannot contain a comma.
        installed="$(printf '%s\n' "$listing" | cut -d, -f1 | grep -v '^name$' || true)"
        changed=0

        set -f
        for want in $(printf '%s' "$HOLD_DEL" | tr ',' ' '); do
            safe_plugin_slug "$want" || die "\"$want\" is not a plugin name"
            is_held "$want" || die "$want is not held on $SITE (see: backup-wp $SITE plugins)"
            kept=""
            for h in $HELD; do
                if [ "$h" != "$want" ]; then kept="$kept $h"; fi
            done
            HELD="$kept"; changed=1
            info "released $want"
        done
        for want in $(printf '%s' "$HOLD_ADD" | tr ',' ' '); do
            safe_plugin_slug "$want" \
                || die "\"$want\" is not a plugin name — those are letters, digits, dots, dashes and underscores"
            # -Fx, because a slug is a name and not a pattern.
            printf '%s\n' "$installed" | grep -Fqx "$want" \
                || die "no plugin named $want is installed on $SSH_HOST (see: backup-wp $SITE plugins)"
            if is_held "$want"; then
                info "$want was already held"
            else
                HELD="$HELD $want"; changed=1
                info "holding $want"
            fi
        done
        set +f

        if [ "$changed" -eq 1 ]; then
            if [ "$DRY" -eq 1 ]; then
                info "would save HOLD_PLUGINS=\"${HELD# }\" to $CONF"
            else
                conf_set_hold "${HELD# }"
                info "saved to ${DIM}$CONF${RST}"
            fi
        fi
    fi

    owned="$(composer_owned)"
    updatable=""; theirs=0; silent=""; withheld=0

    while IFS=, read -r name status version update next; do
        if [ "$name" = "name" ] || [ -z "$name" ]; then continue; fi
        # must-use and drop-ins are not installed plugins and never update
        case "$status" in must-use|dropin) continue ;; esac
        # A held plugin is a decision already taken, so it is shown only when
        # there is something being held back. Held and silent stays quiet:
        # "no updater" exists to send you off to check by hand, which is not
        # advice to give about a plugin you have said to leave alone.
        if is_held "$name"; then
            if [ "$update" = "available" ]; then
                printf '    %-26s %-9s → %-9s %sheld%s\n' \
                    "$name" "$version" "$next" "$YEL" "$RST"
                withheld=$((withheld + 1))
            fi
            continue
        fi
        if [ "$update" != "available" ]; then
            # Server-managed and never heard from: a human has to go and look.
            if ! printf '%s\n' "$owned" | grep -Fqx "$name" \
               && ! printf '%s\n' "$known" | grep -Fqx "$name"; then
                silent="$silent $name:$version"
            fi
            continue
        fi
        # -F throughout: a plugin slug is a directory name, not a pattern, and
        # `.` is legal in one. Without it `wp.rocket` matches `wp-rocket` and a
        # server-managed plugin is quietly filed as Composer's and never updated.
        if printf '%s\n' "$owned" | grep -Fqx "$name"; then
            printf '    %-26s %-9s → %-9s %scomposer%s\n' \
                "$name" "$version" "$next" "$DIM" "$RST"
            theirs=$((theirs + 1))
        else
            printf '    %-26s %-9s → %-9s %sserver%s\n' \
                "$name" "$version" "$next" "$B" "$RST"
            updatable="$updatable $name"
        fi
    done <<EOF
$listing
EOF

    if [ -n "$silent" ]; then
        for s in $silent; do
            printf '    %-26s %-9s %-11s %sno updater%s\n' \
                "${s%%:*}" "${s##*:}" "" "$YEL" "$RST"
        done
    fi

    if [ "$theirs" -gt 0 ]; then
        info "composer ones belong to \`composer update\` locally, then deploy —"
        info "updating them here is undone by the next deploy"
    fi

    if [ "$withheld" -gt 0 ]; then
        info "held ones stay put until ${B}--unhold=<name>${RST} — the list is"
        info "HOLD_PLUGINS in $CONF"
    fi

    if [ -n "$silent" ]; then
        info "\"no updater\" means WordPress has never heard from that plugin, not"
        info "that it is current. Check those by hand; --update cannot fetch an"
        info "update nobody reported."
    fi
    if [ "$admin_ctx" -eq 0 ]; then
        warn "could not load admin context, so licensed plugins that register"
        warn "their update checks there may be missing from this list"
    fi

    # --update=a,b narrows to named plugins. Every name is checked against what
    # was actually found, so a typo stops the run instead of quietly updating
    # nothing and looking like success.
    if [ -n "$ONLY" ]; then
        in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
        chosen=""
        for want in $(printf '%s' "$ONLY" | tr ',' ' '); do
            if in_list "$want" "$updatable"; then
                chosen="$chosen $want"
            elif is_held "$want"; then
                die "$want is held on $SITE — release it with \`backup-wp $SITE plugins --unhold=$want\` if you mean to update it"
            elif printf '%s\n' "$owned" | grep -Fqx "$want"; then
                die "$want is Composer-managed — update it with \`composer update\` locally, or the next deploy reverts it"
            elif in_list "$want" "$(printf '%s' "$silent" | tr ':' ' ')"; then
                die "$want reports no updater, so there is no update to fetch — update it by hand"
            else
                die "$want is not a server-managed plugin with a pending update (see: backup-wp $SITE plugins)"
            fi
        done
        updatable="$chosen"
    fi

    if [ -z "$updatable" ]; then
        if [ "$withheld" -gt 0 ]; then
            info "everything with a pending update is held"
        else
            info "nothing to update on the server"
        fi
    elif [ "$APPLY" -eq 0 ]; then
        info "run with ${B}--update${RST} for all of these, or ${B}--update=<name>${RST} for one"
    else
        for p in $updatable; do
            if [ "$DRY" -eq 1 ]; then
                info "would update $p"
            else
                remote_wp plugin update "$p" 2>&1 | sed 's/^/    /' \
                    || warn "$p did not update cleanly"
            fi
        done
    fi
fi

# ── 4. prune ────────────────────────────────────────────────────────────────
# Age is read from the stamp the name ends in, never from the name as a whole:
# `pre-update` and `post-update` sit in front of the date, so a plain reverse
# sort would rank every pre- above every post- above every unlabelled snapshot
# and delete this morning's backup while keeping one from last spring. Each
# path is tagged with its stamp and sorted on that instead.
#
# A name from before this scheme (<site>-db-20200101-000000-pre.sql.gz) tags as
# zeros and so sorts oldest, which is exactly what it is: every one of them
# predates the rename.
#
# The depth bounds are the safety rail: retention is confined to the exact
# level this script writes to, so anything filed elsewhere under the backup
# root — a manual export, a keep/ folder, an old dump — is invisible to it
# even when the name matches.
newest_first() {
    local ext="$1" f base key
    while IFS= read -r f; do
        base="${f##*/}"
        key="${base%"$ext"}"
        key="${key: -17}"
        case "$key" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) ;;
            *) key="00000000000000000" ;;
        esac
        printf '%s\t%s\n' "$key" "$f"
    done | LC_ALL=C sort -r | cut -c19-
}

prune() {
    local dir="$1" pattern="$2" keep="$3" mind="$4" maxd="$5"
    [ -d "$dir" ] || return 0
    # Every pattern here is <prefix>*<extension>, so what follows the wildcard
    # is the suffix to strip before reading the stamp off the end.
    find "$dir" -mindepth "$mind" -maxdepth "$maxd" -type f -name "$pattern" \
        2>/dev/null | newest_first "${pattern##*\*}" | tail -n "+$((keep + 1))" |
        while IFS= read -r old; do
            if [ "$DRY" -eq 1 ]; then
                info "would prune $(basename "$old")"
            else
                rm -f -- "$old"
                info "pruned $(basename "$old")"
            fi
        done
}

if [ "$PRUNE" -eq 1 ]; then
    # 4 == <root>/<year>/<month>/<site>/<file>; 1 == straight inside sql/
    if [ "$DO_DB" -eq 1 ]; then
        prune "$BACKUP_ROOT" "$SITE-db-*.sql.gz" "$KEEP"     4 4
        prune "$LOCAL_SQL"   "$SITE-db-*.sql"    "$KEEP_SQL" 1 1
    fi
    if [ "$ARCHIVE" -eq 1 ]; then
        prune "$BACKUP_ROOT" "$SITE-uploads-*.tar.zst" "$KEEP" 4 4
    fi
fi

trap - EXIT
printf '\n%s✓%s %s @ %s\n' "$GRN" "$RST" "$SITE" "$STAMP"
